# Netlify applies the FIRST matching rule: specific rules first, the SPA fallback last.

# Languages: English is the default at /, French is prerendered at /fr/
/en              /                301
/en/*            /                301
/fr              /fr/             301
/fr/*            /fr/index.html   200

